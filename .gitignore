# Node.js / React / Frontend
# ============================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules/
jspm_packages/

# Build outputs
dist/
dist-ssr/
build/
*.local

# Testing
coverage/
.nyc_output/

# Production
/build

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files
.env*.local

# Vite
.vite/

# ============================================
# IDEs and Editors
# ============================================

# VSCode
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# IntelliJ IDEA / PyCharm
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# ============================================
# OS Files
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================
# Project Specific
# ============================================

# Logs directory
logs/
*.log

# Database files
*.sqlite3
*.sqlite
*.db

# Media files (user uploaded content)
backend/media/**/*
!backend/media/
!backend/media/.gitkeep

# Static files (collected)
backend/staticfiles/
backend/static_root/

# Environment variables
.env
.env.local
.env.development
.env.production
.env.test
*.env

# CSV data files (if large)
*.csv
!model/data/clean_training.csv  # Keep training data if needed

# Model artifacts (keep production models, ignore training artifacts)
model/*.pkl
!model/production_model_*.pkl
model/*.joblib
!model/production_model_*.joblib

# Backup files
*.bak
*.backup
*.old
*.orig
*.tmp

# Lock files (optional - uncomment if you want to ignore)
# package-lock.json
# yarn.lock
# bun.lockb

# ============================================
# Temporary files
# ============================================

*.tmp
*.temp
*.swp
*.swo
*~
.cache/

# ============================================
# Deployment
# ============================================

# Docker
.dockerignore
docker-compose.override.yml

# Kubernetes
*.kubeconfig

# Terraform
*.tfstate
*.tfstate.*
.terraform/

# ============================================
# Security
# ============================================

# Secrets and credentials
secrets/
*.pem
*.key
*.crt
*.p12
*.pfx
credentials.json
service-account.json

# ============================================
# Machine Learning / Data Science
# ============================================

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Model checkpoints (keep production models)
*.ckpt
*.h5
*.hdf5
*.pb
*.onnx

# Data files (large datasets)
*.csv.gz
*.parquet
*.feather
*.arrow

# ============================================
# Miscellaneous
# ============================================

# Archive files
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Compiled files
*.class
*.dll
*.exe
*.o
*.so

# System files
.Spotlight-V100
.Trashes

